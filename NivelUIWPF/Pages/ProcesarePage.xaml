<Page x:Class="NivelUIWPF.Pages.ProcesarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Procesare" Background="#ECF0F1">
    <Grid Margin="10">
        <StackPanel VerticalAlignment="Top" Spacing="15">
            <TextBlock Text="INFORMAȚII PROCESARE LEMN" 
                       FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <TextBlock Text="Adăugare / Editare Procesare" FontSize="16" FontWeight="Bold" Foreground="#3498DB"/>
                    
                    <StackPanel>
                        <TextBlock Text="ID:" Foreground="#2C3E50" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBox x:Name="IdTextBox" Style="{StaticResource ModernTextBoxStyle}" Text=""/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Cantitate Procesată (m³):" Foreground="#2C3E50" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBox x:Name="CantitateTextBox" Style="{StaticResource ModernTextBoxStyle}" Text=""/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Data Procesării:" Foreground="#2C3E50" FontWeight="Bold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DataPicker" Height="35" Padding="10" Background="White"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Adăugare" Click="AddProcesare" Style="{StaticResource ModernButtonStyle}" Width="150"/>
                        <Button Content="Ștergere" Click="DeleteProcesare" Style="{StaticResource AccentButtonStyle}" Width="150"/>
                        <Button Content="Refresh" Click="RefreshProcesareList" Style="{StaticResource ModernButtonStyle}" Width="150"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Lista Procesări" FontSize="16" FontWeight="Bold" Forecolor="#3498DB"/>
                    
                    <DataGrid x:Name="ProcesareDataGrid" AutoGenerateColumns="False" Height="300" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Cantitate (m³)" Binding="{Binding CantitateProcessata}" Width="120"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="120"/>
                            <DataGridTextColumn Header="Lemn Inițial" Binding="{Binding LemnInitial.TipLemn}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="3" Padding="15" Background="#F8F9F9">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Detalii Procesare Selectată" FontSize="13" FontWeight="Bold" Foreground="#3498DB"/>
                            <TextBlock x:Name="SelectedInfoBlock" Text="Selectați o procesare din listă pentru a vedea detaliile" Foreground="#555555"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
