<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionare Lemn" Height="600" Width="900"
	MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<Style TargetType="TextBox">
			<Style.Triggers>
				<Trigger Property="Validation.HasError" Value="True">
					<Setter Property="ToolTip"
							Value="{Binding RelativeSource={RelativeSource Self},
							Path=(Validation.Errors)[0].ErrorContent}"/>
					<Setter Property="BorderBrush" Value="Red"/>
					<Setter Property="BorderThickness" Value="2"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="180"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		
		<StackPanel Grid.Column="0" Background="#2C3E2D">

			<TextBlock Text="Gestionare Lemn"
                       Foreground="White" FontSize="14" FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="15,20,15,30"/>

			<Button Content="Clienti"
                    Background="Transparent" Foreground="White"
                    BorderThickness="1" Height="45"
                    HorizontalContentAlignment="Left" Padding="15,0"
                    FontSize="13" Cursor="Hand"
                    Click="btnMenuClienti_Click"/>
			<Button Content="Lemn Brut"
                    Background="#2C3E2D" Foreground="White"
                    BorderThickness="1" Height="45"
                    HorizontalContentAlignment="Left" Padding="15,0"
                    FontSize="13" Cursor="Hand"
                    Click="btnMenuLemnBrut_Click"/>
			<Button Content="Procesare"
					Background="Transparent" Foreground="White"
					BorderThickness="1" Height="45"
					HorizontalContentAlignment="Left" Padding="15,0"
					FontSize="13" Cursor="Hand"
					Click="btnMenuProcesare_Click"/>
			<Button Content="Vanzare"
					Background="Transparent" Foreground="White"
					BorderThickness="1" Height="45"
					HorizontalContentAlignment="Left" Padding="15,0"
					FontSize="13" Cursor="Hand"
					Click="btnMenuVanzare_Click"/>

		</StackPanel>

		
		<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<Grid Background="#F4F1EC">

			<!-- PANOUL CLIENTI -->
			<StackPanel x:Name="panelClienti" Margin="30" Visibility="Visible">

				<TextBlock Text="Gestionare Clienti"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#2C3E2D" Margin="0,0,0,20"/>

				<TextBlock x:Name="lblNume" Text="Nume:" Foreground="#333"/>
				<TextBox x:Name="txtNume" Padding="6" Width="659" BorderThickness="1" BorderBrush="Gray"
						 Text="{Binding Nume, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>

				<TextBlock x:Name="lblTelefon" Text="Telefon (10 cifre):" Foreground="#333" Margin="0,10,0,0"/>
				<TextBox x:Name="txtTelefon" Margin="0,4,0,10" Padding="6" BorderThickness="1" BorderBrush="Gray"
						 Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>

				<TextBlock x:Name="lblEmail" Text="Email (cu @):" Foreground="#333"/>
				<TextBox x:Name="txtEmail" Margin="0,4,0,10" Padding="6" BorderThickness="1" BorderBrush="Gray"
						 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>

				<!-- Butoane principale -->
				<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
					<Button Content="Adauga" Width="100" Height="35"
							Background="#2C3E2D" Foreground="White"
							BorderThickness="0" Cursor="Hand"
							Click="btnAdaugaClient_Click"/>
					<Button Content="Editeaza" Width="100" Height="35"
							Background="#5C6D3A" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnEditeazaClient_Click"/>
					<Button Content="Sterge" Width="100" Height="35"
							Background="#B04A3F" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnStergeClient_Click"/>
					<Button Content="Afiseaza" Width="100" Height="35"
							Background="#8FBC5A" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnAfiseazaClienti_Click"/>
				</StackPanel>

				<TextBlock Text="Cauta client dupa nume:" Foreground="#333"/>
				<StackPanel Orientation="Horizontal" Margin="0,4,0,10">
					<TextBox x:Name="txtCautaClient" Width="300" Padding="6" BorderThickness="1" BorderBrush="Gray"/>
					<Button Content="Cauta" Width="100" Height="35"
							Background="#2C3E2D" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnCautaClient_Click"/>
				</StackPanel>

				<TextBlock x:Name="txtMesajClient" Margin="0,0,0,10" FontSize="13" FontWeight="Bold"/>


				<DataGrid x:Name="dgClienti"
                          AutoGenerateColumns="False" IsReadOnly="True"
						  CanUserAddRows="False" Height="220"
						  SelectionChanged="dgClienti_SelectionChanged">
					<DataGrid.Columns>
						<DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
						<DataGridTextColumn Header="Nume" Binding="{Binding Nume}" Width="*"/>
						<DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="120"/>
						<DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
					</DataGrid.Columns>
				</DataGrid>

			</StackPanel>

			<!-- PANOUL LEMN BRUT -->
			<StackPanel x:Name="panelLemnBrut" Margin="30" Visibility="Collapsed">

				<TextBlock Text="Gestionare Lemn Brut"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#2C3E2D" Margin="0,0,0,20"/>

				<TextBlock x:Name="lblTipLemn" Text="Tip Lemn (ListBox):" Foreground="#333"/>
				<ListBox x:Name="lstTipLemn" Margin="0,4,0,10" Padding="6" Height="100" SelectionMode="Single">
					<ListBoxItem>Molid</ListBoxItem>
					<ListBoxItem>Brad</ListBoxItem>
					<ListBoxItem>Fag</ListBoxItem>
					<ListBoxItem>Stejar</ListBoxItem>
					<ListBoxItem>Pin</ListBoxItem>
				</ListBox>

				<TextBlock x:Name="lblCantitate" Text="Cantitate (mc):" Foreground="#333"/>
				<TextBox x:Name="txtCantitate" Margin="0,4,0,10" Padding="6"/>

				<TextBlock x:Name="txtMesajLemn" Margin="0,0,0,10"/>

				<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
					<Button Content="Adauga" Width="100" Height="35"
							Background="#2C3E2D" Foreground="White"
							BorderThickness="0" Cursor="Hand"
							Click="btnAdaugaLemn_Click"/>
					<Button Content="Editeaza" Width="100" Height="35"
							Background="#5C6D3A" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnEditeazaLemn_Click"/>
					<Button Content="Sterge" Width="100" Height="35"
							Background="#B04A3F" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnStergeLemn_Click"/>
				</StackPanel>

				<DataGrid x:Name="dgLemnBrut"
                          AutoGenerateColumns="False" IsReadOnly="True"
						  CanUserAddRows="False" Height="220"
						  SelectionChanged="dgLemnBrut_SelectionChanged">
					<DataGrid.Columns>
						<DataGridTextColumn Header="ID" Binding="{Binding Id}"  Width="50"/>
						<DataGridTextColumn Header="Tip Lemn" Binding="{Binding TipLemn}"  Width="*"/>
						<DataGridTextColumn Header="Cantitate (mc)" Binding="{Binding CantitateMc}" Width="140"/>
					</DataGrid.Columns>
				</DataGrid>

			</StackPanel>
			<!-- PANOUL PROCESARE -->
			<StackPanel x:Name="panelProcesare" Margin="30" Visibility="Collapsed">

				<TextBlock Text="Procesare Lemn" FontSize="20" FontWeight="Bold"
               Foreground="#2C3E2D" Margin="0,0,0,20"/>

				
				<TextBlock x:Name="lblTipLemnProcesare" Text="Tip Lemn:" Foreground="#333"/>
				<StackPanel Orientation="Horizontal" Margin="0,4,0,10">
					<RadioButton x:Name="rdoMolid" Content="Molid" Margin="0,0,15,0" GroupName="TipLemn" Checked="TipLemnProcesare_Checked"/>
					<RadioButton x:Name="rdoBrad" Content="Brad" Margin="0,0,15,0" GroupName="TipLemn" Checked="TipLemnProcesare_Checked"/>
					<RadioButton x:Name="rdoFag" Content="Fag" Margin="0,0,15,0" GroupName="TipLemn" Checked="TipLemnProcesare_Checked"/>
					<RadioButton x:Name="rdoStejar" Content="Stejar" Margin="0,0,15,0" GroupName="TipLemn" Checked="TipLemnProcesare_Checked"/>
					<RadioButton x:Name="rdoPin" Content="Pin" GroupName="TipLemn" Checked="TipLemnProcesare_Checked"/>
				</StackPanel>

				<TextBlock x:Name="txtCantitateDisponibila" Margin="0,0,0,10" Foreground="#333"/>

				<!-- Cantitate procesata -->
				<TextBlock x:Name="lblCantProcesare" Text="Cantitate procesata (mc):" Foreground="#333"/>
				<TextBox x:Name="txtCantProcesare" Margin="0,4,0,10" Padding="6"/>

				<!-- Produs rezultat -->
				<TextBlock Text="Produs rezultat:" Foreground="#333"/>
				<ComboBox x:Name="cmbTipProdusProcesare" Margin="0,4,0,10" Padding="6"/>

				
				<TextBlock Text="Caracteristici produs:" Foreground="#333"/>
				<StackPanel Orientation="Horizontal" Margin="0,4,0,10">
					<CheckBox x:Name="chkUscat" Content="Uscat" Margin="0,0,15,0"/>
					<CheckBox x:Name="chkTratat" Content="Tratat" Margin="0,0,15,0"/>
					<CheckBox x:Name="chkLustruit" Content="Lustruit" Margin="0,0,15,0"/>
					<CheckBox x:Name="chkCertificat" Content="Certificat"/>
				</StackPanel>

				<TextBlock x:Name="txtMesajProcesare" Margin="0,0,0,10"/>

				<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
					<Button Content="Adauga" Width="100" Height="35"
							Background="#2C3E2D" Foreground="White"
							BorderThickness="0" Cursor="Hand"
							HorizontalAlignment="Left"
							Click="btnAdaugaProcesare_Click"/>
					<Button Content="Editeaza" Width="100" Height="35"
							Background="#5C6D3A" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnEditeazaProcesare_Click"/>
					<Button Content="Sterge" Width="100" Height="35"
							Background="#B04A3F" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnStergeProcesare_Click"/>
				</StackPanel>

				<DataGrid x:Name="dgProcesari"
                          AutoGenerateColumns="False" IsReadOnly="True"
						  CanUserAddRows="False" Height="220"
						  SelectionChanged="dgProcesari_SelectionChanged">
					<DataGrid.Columns>
						<DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
						<DataGridTextColumn Header="Tip lemn" Binding="{Binding LemnInitial.TipLemn}" Width="90"/>
						<DataGridTextColumn Header="Cantitate" Binding="{Binding CantitateProcessata, StringFormat={}{0} mc}" Width="110"/>
						<DataGridTextColumn Header="Produs rezultat" Width="*">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="{}{0} ({1})">
									<Binding Path="ProduseRezultate[0].TipProdus"/>
									<Binding Path="ProduseRezultate[0].Caracteristici"/>
								</MultiBinding>
							</DataGridTextColumn.Binding>
						</DataGridTextColumn>
						<DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="100"/>
					</DataGrid.Columns>
				</DataGrid>


				<TextBlock Text="Produse in stoc" FontSize="16" FontWeight="Bold"
						   Foreground="#2C3E2D" Margin="0,20,0,10"/>
				<TextBlock Text="Cantitate produs (mc):" Foreground="#333"/>
				<TextBox x:Name="txtCantitateProdusEdit" Margin="0,4,0,10" Padding="6"/>
				<TextBlock x:Name="txtMesajProdus" Margin="0,0,0,10"/>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
					<Button Content="Editeaza" Width="100" Height="35"
							Background="#5C6D3A" Foreground="White"
							BorderThickness="0" Cursor="Hand"
							Click="btnEditeazaProdus_Click"/>
					<Button Content="Sterge" Width="100" Height="35"
							Background="#B04A3F" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnStergeProdus_Click"/>
				</StackPanel>

				<DataGrid x:Name="dgProduse"
						  AutoGenerateColumns="False" IsReadOnly="True"
						  CanUserAddRows="False" Height="220"
						  SelectionChanged="dgProduse_SelectionChanged">
					<DataGrid.Columns>
						<DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
						<DataGridTextColumn Header="Tip" Binding="{Binding TipProdus}" Width="*"/>
						<DataGridTextColumn Header="Cantitate" Binding="{Binding Cantitate, StringFormat={}{0} mc}" Width="120"/>
						<DataGridTextColumn Header="Caracteristici" Binding="{Binding Caracteristici}" Width="160"/>
					</DataGrid.Columns>
				</DataGrid>

			</StackPanel>

			<!-- PANOUL VANZARE -->
			<StackPanel x:Name="panelVanzare" Margin="30" Visibility="Collapsed">

				<TextBlock Text="Vanzare" FontSize="20" FontWeight="Bold"
               Foreground="#2C3E2D" Margin="0,0,0,20"/>

				<TextBlock x:Name="lblDataVanzare" Text="Data vanzare (DatePicker):" Foreground="#333"/>
				<DatePicker x:Name="dtpDataVanzare" Margin="0,4,0,10" SelectedDateFormat="Short"/>

				<TextBlock x:Name="lblClientVanzare" Text="Nume client:" Foreground="#333"/>
				<ComboBox x:Name="cmbClientVanzare" Margin="0,4,0,10" Padding="6" DisplayMemberPath="Nume"/>

				<TextBlock x:Name="lblProdusVanzare" Text="Tip produs:" Foreground="#333"/>
				<ComboBox x:Name="cmbProdusVanzare" Margin="0,4,0,10" Padding="6"
						SelectionChanged="CmbProdusVanzare_SelectionChanged"/>

				<TextBlock x:Name="txtCantitateDisponibilaVanzare" Margin="0,0,0,10" Foreground="#333"/>

				<TextBlock x:Name="lblCantVanzare" Text="Cantitate (mc):" Foreground="#333"/>
				<TextBox x:Name="txtCantVanzare" Margin="0,4,0,10" Padding="6"/>

				<TextBlock x:Name="txtMesajVanzare" Margin="0,0,0,10"/>

				<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
					<Button Content="Adauga" Width="100" Height="35"
							Background="#2C3E2D" Foreground="White"
							BorderThickness="0" Cursor="Hand"
							HorizontalAlignment="Left"
							Click="btnAdaugaVanzare_Click"/>
					<Button Content="Editeaza" Width="100" Height="35"
							Background="#5C6D3A" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnEditeazaVanzare_Click"/>
					<Button Content="Sterge" Width="100" Height="35"
							Background="#B04A3F" Foreground="White"
							BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
							Click="btnStergeVanzare_Click"/>
				</StackPanel>

				<DataGrid x:Name="dgVanzari"
                          AutoGenerateColumns="False" IsReadOnly="True"
						  CanUserAddRows="False" Height="220"
						  SelectionChanged="dgVanzari_SelectionChanged">
					<DataGrid.Columns>
						<DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
						<DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="100"/>
						<DataGridTextColumn Header="Client" Binding="{Binding Client.Nume}" Width="*"/>
						<DataGridTextColumn Header="Produs" Width="180">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="{}{0} ({1})">
									<Binding Path="Produs.TipProdus"/>
									<Binding Path="Produs.Caracteristici"/>
								</MultiBinding>
							</DataGridTextColumn.Binding>
						</DataGridTextColumn>
						<DataGridTextColumn Header="Cantitate" Binding="{Binding Cantitate, StringFormat={}{0} mc}" Width="110"/>
					</DataGrid.Columns>
							</DataGrid>
			

			</StackPanel>

			</Grid>
		</ScrollViewer>
	</Grid>
</Window>
