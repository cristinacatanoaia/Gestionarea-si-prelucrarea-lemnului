<Window x:Class="WPF.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:WPF"
		mc:Ignorable="d"
		Title="MainWindow" Height="450" Width="800">
	<Grid Margin="0,0,0,-16">
		<Button Content="AFISEAZA CLIENTI" HorizontalAlignment="Left" Margin="33,25,0,0" VerticalAlignment="Top" Height="33" Width="129" Click="Button_Click"/>
		<ListView x:Name="ClientiListView" Margin="33,85,61,42">
			<ListView.View>
				<GridView>
					<GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
					<GridViewColumn Header="Nume" DisplayMemberBinding="{Binding Nume}" Width="200"/>
					<GridViewColumn Header="Telefon" DisplayMemberBinding="{Binding Telefon}" Width="150"/>
					<GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="300"/>
				</GridView>
			</ListView.View>
		</ListView>

	</Grid>
</Window>
